    weekly_recap_processing_tenant_extractor [fillcolor="#47c2c2",label="weekly_recap\.\nprocessing\.\ntenant_extractor"];
    weekly_recap_run_recap [fillcolor="#47c2c2",label="weekly_recap\.\nrun_recap"];
    certifi -> weekly_recap_auth_ensure_graph_token [fillcolor="#d92626",minlen="3"];
    certifi -> weekly_recap_auth_setup_graph_token [fillcolor="#d92626",minlen="3"];
    certifi -> weekly_recap_fetchers_fetch_calendar [fillcolor="#d92626",minlen="3"];
    certifi -> weekly_recap_fetchers_fetch_jira [fillcolor="#d92626",minlen="3"];
    weekly_recap_preflight -> weekly_recap_cli [fillcolor="#47c2c2"];
    weekly_recap_processing -> weekly_recap_generate_full_report [fillcolor="#22e7e7"];
    weekly_recap_processing_due_date_formatter -> weekly_recap_generate_full_report [fillcolor="#3ab0b0",minlen="2"];
    weekly_recap_processing_environment_extractor -> weekly_recap_generate_full_report [fillcolor="#47c2c2",minlen="2"];
    weekly_recap_processing_models -> weekly_recap_generate_full_report [fillcolor="#22e7e7",minlen="2"];
    weekly_recap_processing_models -> weekly_recap_processing_due_date_formatter [fillcolor="#22e7e7",weight="2"];
    weekly_recap_processing_models -> weekly_recap_processing_report_generator [fillcolor="#22e7e7",weight="2"];
    weekly_recap_processing_models -> weekly_recap_processing_summary_calculator [fillcolor="#22e7e7",weight="2"];
    weekly_recap_processing_report_generator -> weekly_recap_generate_full_report [fillcolor="#3ab0b0",minlen="2"];
