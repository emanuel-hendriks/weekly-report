        <mxCell id="d1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;" value="&lt;font face=&quot;Courier New&quot;&gt;GET api.github.com/search/commits&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;commit sul default branch&lt;/font&gt;" vertex="1">
