<mxfile host="Electron">
  <diagram name="GitHub Auth Flow" id="gh-auth">
    <mxGraphModel dx="948" dy="893" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="700" background="#FFFFFF" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="t1" parent="1" style="text;html=1;align=center;fontSize=13;" value="&lt;b&gt;GitHub: gh (auth) vs httpx (data)&lt;/b&gt;" vertex="1">
          <mxGeometry height="25" width="340" x="330" y="20" as="geometry" />
        </mxCell>
        <mxCell id="s1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;1. Login (una tantum)&lt;/b&gt;&lt;br&gt;L&#39;utente esegue &lt;font face=&quot;Courier New&quot;&gt;gh auth login&lt;/font&gt;.&lt;br&gt;gh apre il browser, l&#39;utente autorizza, gh salva il token su disco." vertex="1">
          <mxGeometry height="55" width="420" x="100" y="70" as="geometry" />
        </mxCell>
        <mxCell id="s1out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=10;" value="&lt;font face=&quot;Courier New&quot;&gt;~/.config/gh/hosts.yml&lt;/font&gt;" vertex="1">
          <mxGeometry height="35" width="200" x="640" y="80" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="s1" style="strokeColor=#000000;endArrow=block;endFill=1;fontSize=9;" target="s1out" value="salva token">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;2. Lettura token (ogni run, 10ms)&lt;/b&gt;&lt;br&gt;Il fetcher chiama &lt;font face=&quot;Courier New&quot;&gt;gh auth token&lt;/font&gt; (unico subprocess).&lt;br&gt;gh legge il file e restituisce il token come stringa." vertex="1">
          <mxGeometry height="55" width="420" x="100" y="170" as="geometry" />
        </mxCell>
        <mxCell id="s2out" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#000000;fontSize=10;" value="&lt;font face=&quot;Courier New&quot;&gt;&quot;gho_AjT6kr11...&quot;&lt;/font&gt;" vertex="1">
          <mxGeometry height="35" width="200" x="640" y="180" as="geometry" />
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="s2" style="strokeColor=#000000;endArrow=block;endFill=1;fontSize=9;" target="s2out" value="restituisce">
          <mxGeometry relative="1" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e12" edge="1" parent="1" source="s1out" style="strokeColor=#000000;endArrow=block;endFill=1;dashed=1;fontSize=9;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="s2" value="legge da">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="145" />
              <mxPoint x="310" y="145" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="s3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#000000;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" value="&lt;b&gt;3. Richieste HTTP (ogni run, ~2s)&lt;/b&gt;&lt;br&gt;&lt;font face=&quot;Courier New&quot;&gt;httpx.AsyncClient&lt;/font&gt; usa il token come header e invia 3 richieste in parallelo." vertex="1">
          <mxGeometry height="50" width="420" x="100" y="275" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="s2out" style="strokeColor=#000000;endArrow=block;endFill=1;fontSize=9;edgeStyle=orthogonalEdgeStyle;rounded=1;" target="s3" value="token passato a httpx">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="740" y="245" />
              <mxPoint x="310" y="245" />
            </Array>
          </mxGeometry>
